{
  "name": "dbmlgraph",
  "version": "0.1.0",
  "description": "DBML → LLM-ready markdown knowledge graph (index, per-table, per-domain) + RAG export",
  "type": "module",
  "license": "MIT",
  "bin": { "dbmlgraph": "dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "keywords": ["dbml", "llm", "ai-agents", "schema", "documentation", "knowledge-graph", "rag"],
  "dependencies": {
    "@dbml/core": "^9.1.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
