Enum order_status {
  pending [note: 'awaiting payment']
  shipped
  cancelled
}

TableGroup identity {
  users
}

Table users {
  id bigint [pk, increment]
  email varchar(100) [unique, not null, note: 'login id']
  referred_by bigint [ref: > users.id]
}

Table settings {
  id bigint [pk]
  key varchar(50)
}

// ============================================================
// DOMAIN 2: Commerce
// ============================================================

Table orders {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  status order_status [default: 'pending']
  channel varchar(20) [not null, note: 'WEB | POS | PARTNER']
  total numeric [not null, note: 'gross amount']
  Note: 'order header'
  Indexes {
    (user_id, status) [name: 'idx_user_status']
  }
}

Table audit_log {
  id bigint [pk]
  payload text
}
